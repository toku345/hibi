# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A small CLI for reflecting on your working day"
description:
  "Answer four short questions and keep a private local JSON record."
depends: [
  "dune" {>= "3.24"}
  "ocaml" {>= "4.14"}
  "yojson"
  "ptime"
  "lambda-term" {>= "3.4.1"}
  "lwt"
  "react"
  "zed"
  "qcheck-core" {with-test & >= "0.91"}
  "conf-python-3" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
